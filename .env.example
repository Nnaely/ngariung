# --- Database (wajib) ---
# Di Vercel diisi otomatis setelah database Neon disambungkan lewat tab Storage.
# Lokal: jalankan `pnpm db:dev`, lalu salin baris di bawah ke .env.local.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# --- Web Push (opsional) ---
# Biarkan kosong: kunci VAPID dibuat otomatis sekali dan disimpan di database.
# Isi hanya kalau ingin memakai pasangan kunci sendiri (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak untuk layanan push. Kosong = memakai alamat produksi Vercel.
VAPID_SUBJECT=
